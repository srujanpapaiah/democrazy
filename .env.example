# Copy to .env and fill in. Never commit the real .env.

# --- Server ---------------------------------------------------------------
# Port the blockchain node listens on.
PORT=3000

# Address of the root node that peers sync their chain from on startup.
ROOT_NODE_ADDRESS=http://localhost:3000

# Set to "true" to start this node on a random port as a peer of the root node.
GENERATE_PEER_PORT=false

# --- PubNub (peer-to-peer broadcast) --------------------------------------
# Get these from https://admin.pubnub.com. The node runs without them, but
# peers will not share blocks or transactions.
PUBNUB_PUBLISH_KEY=
PUBNUB_SUBSCRIBE_KEY=
PUBNUB_SECRET_KEY=

# --- Cross-origin access --------------------------------------------------
# Origins allowed to call this node's API, comma-separated. Required only when
# the client is hosted separately from the node (e.g. client on Vercel, node on
# Render). Leave empty when the node serves the client itself.
CORS_ORIGINS=

# --- Client dev server ----------------------------------------------------
# Where `npm run dev:client` proxies /api requests.
VITE_API_TARGET=http://localhost:3000

# --- Client build ---------------------------------------------------------
# Origin of the node, baked in at build time. Leave unset to call /api on the
# current origin, which is correct locally and when the node serves the client.
# Set it in Vercel to the Render URL, e.g. https://democrazy-node.onrender.com
VITE_API_BASE_URL=
