# Copy to .env and fill in. Never commit the real .env.

# --- Server ---------------------------------------------------------------
# Port the blockchain node listens on.
PORT=3000

# Address of the root node that peers sync their chain from on startup.
ROOT_NODE_ADDRESS=http://localhost:3000

# Set to "true" to start this node on a random port as a peer of the root node.
GENERATE_PEER_PORT=false

# --- PubNub (peer-to-peer broadcast) --------------------------------------
# Get these from https://admin.pubnub.com. The node runs without them, but
# peers will not share blocks or transactions.
PUBNUB_PUBLISH_KEY=
PUBNUB_SUBSCRIBE_KEY=
PUBNUB_SECRET_KEY=

# --- Client dev server ----------------------------------------------------
# Where `npm run dev:client` proxies /api requests.
VITE_API_TARGET=http://localhost:3000
